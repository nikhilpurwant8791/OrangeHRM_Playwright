{
  "name": "orangehrm_playwright",
  "version": "1.0.0",
  "description": "OrangeHRM UI automation with Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:dev": "node --env-file=.env.dev ./node_modules/@playwright/test/cli.js test",
    "test:demo": "node --env-file=.env.demo ./node_modules/@playwright/test/cli.js test",
    "test:prod": "node --env-file=.env.prod ./node_modules/@playwright/test/cli.js test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:lifecycle": "playwright test --grep @lifecycle",
    "test:role": "playwright test --grep @role",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "typescript": "^5.9.3"
  }
}
